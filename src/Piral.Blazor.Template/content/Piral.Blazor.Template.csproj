<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PiralInstance>$(piralInstance)</PiralInstance>
    <NpmRegistry>$(npmRegistry)</NpmRegistry>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Piral.Blazor.DevServer" Version="10.0.19" PrivateAssets="all" />
    <PackageReference Include="Piral.Blazor.Utils" Version="10.0.19" />
    <PackageReference Include="Piral.Blazor.Tools" Version="10.0.19" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Remove=".npmrc" Visible="false" />
  </ItemGroup>

</Project>
