@using System.Collections.Concurrent
@using System.Reflection

@if (_layout is not null)
{
  <LayoutView Layout="@_layout">
    <DynamicComponent Type="@Type" Parameters="@Parameters" />
  </LayoutView>
}
else
{
  <DynamicComponent Type="@Type" Parameters="@Parameters" />
}

@code {
private static readonly ConcurrentDictionary<Type, Type> _layoutAttributeCache = new();

private Type _layout;

/// <summary>
/// The type of the component to render.
/// </summary>
[Parameter]
public Type Type { get; set; }

/// <summary>
/// The arguments of the component to render.
/// </summary>
[Parameter]
public IDictionary<string, object> Parameters { get; set; }

protected override void OnParametersSet()
{
    base.OnParametersSet();
    _layout = _layoutAttributeCache.GetOrAdd(Type, static type => type.GetCustomAttribute<LayoutAttribute>()?.LayoutType);
}
}
