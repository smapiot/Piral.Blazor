    config.swaFile,
    config.paFile,
    manifest,
    ...assets.assemblies.filter((m) => !m.ignored).map((m) => m.source),
    ...assets.files.map((m) => m.source),
    ...assets.satellites.map((m) => m.source)
  ].filter((m) => m.indexOf(`/${config.projectName}.`) !== -1);
